  "mcp_servers": {
   "quill": {
    "command": "/Applications/Quill.app/Contents/Resources/quill-mcp",
    "args": [
     "mcp"
    ],
    "environment_id": "local",
    "enabled": true,
    "tool_timeout_sec": null
   },
   "pencil": {
    "command": "/Applications/Pen.app/mcp-server",
    "args": [
     "--app",
     "desktop",
     "--agent",
     "codexCLI"

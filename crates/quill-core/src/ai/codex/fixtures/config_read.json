    "enabled": true,
    "tool_timeout_sec": null
   }
  },
  "plugins": {
   "chrome@openai-bundled": {
    "enabled": true
   },
   "documents@openai-primary-runtime": {
    "enabled": true
   }
  },
  "apps": null
 },
 "origins": {}
}
